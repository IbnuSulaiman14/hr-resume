# Salin ke .env dan isi. Jangan pernah meng-commit .env.
# Chat dan embedding lewat OpenRouter (API kompatibel OpenAI).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Embedding harus final sebelum ingest penuh: ganti model berarti ingest ulang.
EMBEDDING_MODEL=openai/text-embedding-3-small
# Harus mendukung tool calling di OpenRouter (dipilih dan diuji di B0.4).
CHAT_MODEL=deepseek/deepseek-v4-flash-0731
# Reranker lewat endpoint /rerank OpenRouter; isi off untuk mematikan.
RERANK_MODEL=qwen/qwen3-reranker-8b

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=resumes

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Sesuaikan dengan region proyek Langfuse (EU: cloud, US: us.cloud, JP: jp.cloud).
LANGFUSE_HOST=https://jp.cloud.langfuse.com
