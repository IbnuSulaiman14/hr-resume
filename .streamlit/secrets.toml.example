# Contoh isi secrets untuk Streamlit Community Cloud (App settings > Secrets).
# Untuk lokal, salin ke .streamlit/secrets.toml (sudah di-.gitignore) atau pakai .env.
OPENROUTER_API_KEY = ""
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
EMBEDDING_MODEL = "openai/text-embedding-3-small"
CHAT_MODEL = "deepseek/deepseek-v4-flash-0731"

QDRANT_URL = ""
QDRANT_API_KEY = ""
QDRANT_COLLECTION = "resumes"

LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_SECRET_KEY = ""
LANGFUSE_HOST = "https://jp.cloud.langfuse.com"
